{
  "manifest_version": 3,
  "name": "自动点击器 · Auto Clicker",
  "version": "1.2.0",
  "description": "按设定的次数和间隔自动点击网页元素（默认 .like-btn），带实时进度、随时停止和页面内计时。",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "自动点击器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
